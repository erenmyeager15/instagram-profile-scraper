{
  "name": "instagram-profile-scraper",
  "version": "1.0.0",
  "description": "Low-cost Apify Actor for public Instagram profile analytics",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc",
    "dev": "tsx src/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "apify": "^3.7.2",
    "got-scraping": "^4.2.1",
    "tough-cookie": "6.0.1"
  },
  "devDependencies": {
    "@apify/tsconfig": "^0.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "6.2.1"
    }
  },
  "apify": {
    "actorInterface": "apify/actor-node:20"
  }
}
